-- =========================================
-- TELA ESTICADA (DE VOLTA NA MISC COM TOGGLE)
-- =========================================
local StretchSection = MiscPage:CreateSection("Tela Esticada")

-- Variável para controlar se a tela esticada está ativa
local isStretched = false
local stretchConnection = nil
local Camera = workspace.CurrentCamera

getgenv().Resolution = {
    [".gg/scripters"] = 0.65
}

-- Função que ativa/desativa o efeito
local function ToggleStretch(enable)
    isStretched = enable
    
    if enable then
        -- Se ligar, começa a aplicar o efeito
        stretchConnection = RunService.RenderStepped:Connect(function()
            Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, getgenv().Resolution[".gg/scripters"], 0, 0, 0, 1)
        end)
    else
        -- Se desligar, para o efeito e reseta a câmera
        if stretchConnection then
            stretchConnection:Disconnect()
            stretchConnection = nil
            Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1) -- Reseta a escala Y
        end
    end
end

-- Adiciona o Toggle na aba Misc
StretchSection:AddToggle("EnableStretch", false, function(on)
    ToggleStretch(on)
end, { Title = "Ativar Tela Esticada", Description = "Deixa os modelos mais largos." })

StretchSection:AddSlider("StretchAmount", 0, 100, 35, function(value)
    -- O slider vai de 0 a 100, mas o multiplicador precisa ser entre 0.65 e 1.0
    -- Valor 0 = 1.0 (Normal) | Valor 100 = 0.65 (Máximo esticado)
    local factor = 1.0 - ((value / 100) * 0.35)
    getgenv().Resolution[".gg/scripters"] = factor
end, { Title = "Nível da Tela Esticada", Description = "Ajusta o quão esticado está." })

