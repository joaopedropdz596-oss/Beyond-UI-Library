local function UpdateAllESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == Players.LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChild("Humanoid")
        if not head or not humanoid then continue end
        
        if humanoid.Health <= 0 then
            if ESP_Objects[player] then 
                for _, v in pairs(ESP_Objects[player]) do v:Destroy() end 
                ESP_Objects[player] = nil
            end
            continue 
        end

        if ESP_Objects[player] then for _, v in pairs(ESP_Objects[player]) do v:Destroy() end end
        ESP_Objects[player] = {}
        
        if ESP_State.Enabled and ESP_State.Chams then
            local hl = Instance.new("Highlight")
            hl.Parent = char
            hl.FillColor = Color3.fromRGB(190, 140, 255)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            table.insert(ESP_Objects[player], hl)
        end
        
        if ESP_State.Enabled and ESP_State.Names then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "NameESP"
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = head
            local textLabel = Instance.new("TextLabel")
            textLabel.Parent = billboard
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = player.Name
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            textLabel.TextStrokeTransparency = 0
            textLabel.TextSize = 14
            table.insert(ESP_Objects[player], billboard)
        end

        if ESP_State.Enabled and ESP_State.Distance then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "DistESP"
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 2.0, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = head
            local textLabel = Instance.new("TextLabel")
            textLabel.Parent = billboard
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            textLabel.TextStrokeTransparency = 0
            textLabel.TextSize = 12
            local connection
            connection = RunService.RenderStepped:Connect(function()
                if char.Parent and humanoid.Health > 0 and char:FindFirstChild("HumanoidRootPart") and Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (Players.LocalPlayer.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
                    textLabel.Text = tostring(math.floor(dist)) .. " studs"
                else
                    connection:Disconnect()
                end
            end)
            table.insert(ESP_Objects[player], billboard)
            table.insert(ESP_Objects[player], {Destroy = function() if connection then connection:Disconnect() end end})
        end
        
        if ESP_State.Enabled and ESP_State.HealthBars then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "HealthESP"
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 50, 0, 5)
            billboard.StudsOffset = Vector3.new(1.5, 1.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = head
            local frame = Instance.new("Frame")
            frame.Parent = billboard
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            frame.BorderSizePixel = 0
            local fill = Instance.new("Frame")
            fill.Parent = frame
            fill.Size = UDim2.new(1, 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            fill.BorderSizePixel = 0
            local connection
            connection = RunService.RenderStepped:Connect(function()
                if humanoid then
                    local healthPct = humanoid.Health / humanoid.MaxHealth
                    fill.Size = UDim2.new(healthPct, 0, 1, 0)
                    fill.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 0)
                else
                    connection:Disconnect()
                end
            end)
            table.insert(ESP_Objects[player], billboard)
            table.insert(ESP_Objects[player], {Destroy = function() if connection then connection:Disconnect() end end})
        end
    end
end

